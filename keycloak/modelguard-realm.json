    {"clientId": "external-agent", "enabled": true, "protocol": "openid-connect", "publicClient": false, "secret": "external-secret", "serviceAccountsEnabled": true, "standardFlowEnabled": false, "directAccessGrantsEnabled": false},
    {"clientId": "modelguard-admin", "enabled": true, "protocol": "openid-connect", "publicClient": false, "secret": "admin-agent-secret", "serviceAccountsEnabled": true, "standardFlowEnabled": false, "directAccessGrantsEnabled": false}
