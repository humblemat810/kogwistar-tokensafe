    %% Logical (application-level) relationships.
    %% NOTE: the current schema does not enforce SQL FOREIGN KEY constraints.
    graph_edges }o--|| graph_nodes : "source -> graph_nodes.id (logical)"
    graph_edges }o--|| graph_nodes : "target -> graph_nodes.id (logical)"
    graph_events }o--o| graph_nodes : "subject -> graph_nodes.id (logical)"

    %% Polymorphic append log relation by (record_type, id) convention.
    graph_records }o--o| graph_nodes : "id where record_type='node' (logical)"
    graph_records }o--o| graph_edges : "id where record_type='edge' (logical)"
    graph_records }o--o| graph_events : "id where record_type='event' (logical)"
    graph_records }o--o| named_projections : "namespace:key where record_type='projection' (logical)"
