# Single source of truth for split-target production deployment.
#
# Copy this to deploy/deployment-targets.env and edit that one file, or export
# these variables in CI and use scripts/gateway_from_deployment_targets.sh
# --from-env. Component env files are rendered from this source; do not manually
# keep gateway/postgres/keycloak env files in sync.

MODELKEYGUARD_GATEWAY_HOST='<gateway-machine-a-dns-or-ip>'
MODELKEYGUARD_GATEWAY_PORT=8789
MODELKEYGUARD_GATEWAY_PUBLIC_URL='https://<gateway-machine-a-dns>'

MODELKEYGUARD_POSTGRES_HOST='<postgres-machine-b-dns-or-ip>'
MODELKEYGUARD_POSTGRES_PORT=5432
MODELKEYGUARD_POSTGRES_DB=modelguard
MODELKEYGUARD_POSTGRES_USER=modelguard
# Optional gateway-container view of Postgres. Leave unset for real split
# targets. For same-machine compose gateway redeploys, deploy_remote_stack.sh
# sets this to postgres:5432 when it detects the existing compose Postgres
# service in the same project.
# MODELKEYGUARD_GATEWAY_POSTGRES_HOST=postgres
# MODELKEYGUARD_GATEWAY_POSTGRES_PORT=5432

MODELKEYGUARD_KEYCLOAK_HOST='<keycloak-machine-c-dns-or-ip>'
MODELKEYGUARD_KEYCLOAK_PORT=443
MODELKEYGUARD_KEYCLOAK_PUBLIC_URL='https://<keycloak-machine-c-dns>'
MODELKEYGUARD_KEYCLOAK_REALM=modelguard
MODELKEYGUARD_KEYCLOAK_INTROSPECTION_CLIENT_ID=modelguard-gateway
# Optional gateway-container view of Keycloak/OIDC. Leave unset for real split
# targets. For same-machine compose gateway redeploys, deploy_remote_stack.sh
# sets this to http://keycloak:8080 when it detects the existing compose
# Keycloak service in the same project.
# MODELKEYGUARD_GATEWAY_KEYCLOAK_URL=http://keycloak:8080

MODELKEYGUARD_ADMIN_REQUIRED_ROLE=model.admin
