# Machine A: token-safe gateway container
#
# Copy this into your deployment system and replace every <...> placeholder.
# Secrets should be mounted as files and referenced through *_FILE variables.

MODELKEYGUARD_ENV=production
MODELKEYGUARD_STORE=kogwistar_postgres
MODELKEYGUARD_POSTGRES_DSN=postgresql://modelguard:<password>@postgres-b.example:5432/modelguard

MODELKEYGUARD_GRAPH_KEY_FILE=/run/secrets/modelkeyguard_graph_key
MODELKEYGUARD_ADMIN_API_SECRET_FILE=/run/secrets/modelkeyguard_admin_api_secret
KEYCLOAK_INTROSPECTION_CLIENT_SECRET_FILE=/run/secrets/keycloak_client_secret

MODELKEYGUARD_KOGWISTAR_ENFORCE_INSTALLED_ONLY=1
MODELKEYGUARD_USE_INSTALLED_KOGWISTAR=1

KEYCLOAK_URL=https://keycloak-c.example
KEYCLOAK_REALM=modelguard
KEYCLOAK_INTROSPECTION_CLIENT_ID=modelguard-gateway

MODELKEYGUARD_AUTH_MODE=keycloak
MODELKEYGUARD_REQUIRE_KEYCLOAK=1
MODELKEYGUARD_ADMIN_AUTH_MODE=keycloak
MODELKEYGUARD_ADMIN_REQUIRED_ROLE=model.admin
MODELKEYGUARD_REQUIRE_MODEL_LIST_AUTH=1

MODELKEYGUARD_DRY_RUN=0
MODELKEYGUARD_HOST=0.0.0.0
MODELKEYGUARD_PORT=8789
MODELKEYGUARD_POLICY_PATH=config/gateway_policy.json

# Optional provider defaults. You can also set upstream_url per key when
# registering provider keys through /admin/keys.
# OPENAI_UPSTREAM_URL=https://api.openai.com/v1/chat/completions
# AZURE_OPENAI_UPSTREAM_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=<version>
# GEMINI_UPSTREAM_URL=https://generativelanguage.googleapis.com/v1beta/models/<model>:generateContent
# OLLAMA_UPSTREAM_URL=http://ollama-b.example:11434/api/chat
