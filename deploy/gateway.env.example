# GENERATED REFERENCE: Machine A token-safe gateway container
#
# Do not edit this as a production source of truth.
# Edit only deploy/deployment-targets.env, or export those variables in CI, then
# run scripts/render_deployment_env.sh or scripts/gateway_from_deployment_targets.sh.

MODELKEYGUARD_POSTGRES_HOST=<postgres-machine-b-dns-or-ip>
MODELKEYGUARD_POSTGRES_PORT=5432
MODELKEYGUARD_POSTGRES_DB=modelguard
MODELKEYGUARD_POSTGRES_USER=modelguard

MODELKEYGUARD_KEYCLOAK_HOST=<keycloak-machine-c-dns-or-ip>
MODELKEYGUARD_KEYCLOAK_PORT=443
MODELKEYGUARD_KEYCLOAK_PUBLIC_URL=https://<keycloak-machine-c-dns>
MODELKEYGUARD_KEYCLOAK_REALM=modelguard
MODELKEYGUARD_KEYCLOAK_INTROSPECTION_CLIENT_ID=modelguard-gateway

MODELKEYGUARD_GATEWAY_HOST=<gateway-machine-a-dns-or-ip>
MODELKEYGUARD_GATEWAY_PORT=8789
MODELKEYGUARD_GATEWAY_PUBLIC_URL=https://<gateway-machine-a-dns>

MODELKEYGUARD_ENV=production
MODELKEYGUARD_STORE=kogwistar_postgres
MODELKEYGUARD_POSTGRES_DSN=postgresql://modelguard:<postgres-password>@<postgres-machine-b-dns-or-ip>:5432/modelguard

MODELKEYGUARD_GRAPH_KEY_FILE=/run/secrets/modelkeyguard_graph_key
MODELKEYGUARD_ADMIN_API_SECRET_FILE=/run/secrets/modelkeyguard_admin_api_secret
KEYCLOAK_INTROSPECTION_CLIENT_SECRET_FILE=/run/secrets/keycloak_client_secret

MODELKEYGUARD_KOGWISTAR_ENFORCE_INSTALLED_ONLY=1
MODELKEYGUARD_USE_INSTALLED_KOGWISTAR=1

KEYCLOAK_URL=https://<keycloak-machine-c-dns>
KEYCLOAK_REALM=modelguard
KEYCLOAK_INTROSPECTION_CLIENT_ID=modelguard-gateway

MODELKEYGUARD_AUTH_MODE=keycloak
MODELKEYGUARD_REQUIRE_KEYCLOAK=1
MODELKEYGUARD_ADMIN_AUTH_MODE=keycloak
MODELKEYGUARD_ADMIN_REQUIRED_ROLE=model.admin
MODELKEYGUARD_REQUIRE_MODEL_LIST_AUTH=1

MODELKEYGUARD_DRY_RUN=0
MODELKEYGUARD_HOST=0.0.0.0
MODELKEYGUARD_PORT=8789
MODELKEYGUARD_POLICY_PATH=config/gateway_policy.json

