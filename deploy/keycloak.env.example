# Machine C: Keycloak or compatible OIDC provider
#
# This documents the IdP target that the gateway on machine A will use for token
# introspection and admin role checks.

KEYCLOAK_URL=https://keycloak-c.example
KEYCLOAK_REALM=modelguard
KEYCLOAK_INTROSPECTION_CLIENT_ID=modelguard-gateway
KEYCLOAK_INTROSPECTION_CLIENT_SECRET_FILE=/run/secrets/keycloak_client_secret

MODELKEYGUARD_OIDC_USER_CLIENT_ID=<client-id-for-model-users>
MODELKEYGUARD_OIDC_ADMIN_CLIENT_ID=<client-id-for-admins>
MODELKEYGUARD_ADMIN_REQUIRED_ROLE=model.admin

# Production checklist:
# - gateway introspection client is confidential
# - admin tokens carry model.admin role or scope
# - user/client tokens map to graph principals
# - TLS enabled
# - firewall allows machine A to reach the IdP
