# GENERATED REFERENCE: Machine C Keycloak or compatible OIDC provider
#
# Do not edit this as a production source of truth.
# Edit only deploy/deployment-targets.env, or export those variables in CI, then
# run scripts/render_deployment_env.sh.

MODELKEYGUARD_KEYCLOAK_HOST=<keycloak-machine-c-dns-or-ip>
MODELKEYGUARD_KEYCLOAK_PORT=443
MODELKEYGUARD_KEYCLOAK_PUBLIC_URL=https://<keycloak-machine-c-dns>
MODELKEYGUARD_KEYCLOAK_REALM=modelguard
MODELKEYGUARD_KEYCLOAK_INTROSPECTION_CLIENT_ID=modelguard-gateway
MODELKEYGUARD_OIDC_BROWSER_CLIENT_ID=modelguard-admin-web
MODELKEYGUARD_OIDC_USAGE_CLIENT_ID=modelguard-usage-agent

KEYCLOAK_URL=https://<keycloak-machine-c-dns>
KEYCLOAK_REALM=modelguard
KEYCLOAK_INTROSPECTION_CLIENT_ID=modelguard-gateway
KEYCLOAK_INTROSPECTION_CLIENT_SECRET_FILE=/run/secrets/keycloak_client_secret

MODELKEYGUARD_OIDC_USER_CLIENT_ID=<client-id-for-model-users>
MODELKEYGUARD_OIDC_ADMIN_CLIENT_ID=<client-id-for-admins>
MODELKEYGUARD_OIDC_USAGE_CLIENT_ID=<client-id-for-usage-agent>
MODELKEYGUARD_ADMIN_REQUIRED_ROLE=model.admin
MODELKEYGUARD_USAGE_REQUIRED_ROLE=model.usage.read

# Production checklist:
# - gateway introspection client is confidential
# - admin tokens carry model.admin role or scope
# - user/client tokens map to graph principals
# - TLS enabled
# - firewall allows machine A to reach the IdP
