# GENERATED REFERENCE: Machine B pgvector PostgreSQL
#
# Do not edit this as a production source of truth.
# Edit only deploy/deployment-targets.env, or export those variables in CI, then
# run scripts/render_deployment_env.sh.

POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_DB=modelguard
POSTGRES_USER=modelguard
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
POSTGRES_PORT=5432
POSTGRES_DATA_DIR=/var/lib/modelkeyguard/postgres
MODELKEYGUARD_POSTGRES_HOST=<postgres-machine-b-dns-or-ip>

# Gateway DSN that machine A should use after this database is reachable:
MODELKEYGUARD_POSTGRES_DSN=postgresql://modelguard:<postgres-password>@<postgres-machine-b-dns-or-ip>:5432/modelguard

# Production checklist:
# - persistent storage mounted at POSTGRES_DATA_DIR
# - backups and restore test
# - firewall allows machine A only
# - TLS or private network between A and B
# - pgvector extension available
