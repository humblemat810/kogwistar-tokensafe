MODELKEYGUARD_ENV=local
MODELKEYGUARD_AUTH_MODE=local
MODELKEYGUARD_DRY_RUN=1
MODELKEYGUARD_HOST=0.0.0.0
MODELKEYGUARD_PORT=8789
MODELKEYGUARD_GRAPH_KEY_FILE=./secrets/modelkeyguard_graph_key
MODELKEYGUARD_POLICY_PATH=config/gateway_policy.json
MODELKEYGUARD_STORE=jsonl
MODELKEYGUARD_GRAPH_PATH=out/modelkeyguard_graph.jsonl
MODELKEYGUARD_AUDIT_PATH=out/audit.jsonl
# Provider keys: use *_FILE in real deployments, not raw .env values.
# Prefer registering provider keys after deploy through /admin/keys. Set this
# only when you intentionally want a runtime fallback provider secret file.
# MODELKEYGUARD_PROVIDER_KEY_OPENAI_FILE=./secrets/openai_provider_key
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=modelguard
KEYCLOAK_INTROSPECTION_CLIENT_ID=modelguard-gateway
KEYCLOAK_INTROSPECTION_CLIENT_SECRET_FILE=./secrets/keycloak_client_secret
