MODELKEYGUARD_ENV=local
MODELKEYGUARD_AUTH_MODE=local
MODELKEYGUARD_REVIEW_PIPELINE=legacy_adapter
MODELKEYGUARD_RESERVATION_TTL_SECONDS=600
MODELKEYGUARD_RESERVATION_CAS_RETRIES=3
MODELKEYGUARD_IDEMPOTENCY_RETENTION_SECONDS=86400
MODELKEYGUARD_PROVIDER_DRAIN_TIMEOUT_SECONDS=180
# Optional read-only provider reconciliation endpoints; URL must contain {request_id}.
# MODELKEYGUARD_OPENAI_RECONCILE_URL=https://provider.example/reconcile/{request_id}
# MODELKEYGUARD_OPENAI_RECONCILE_TOKEN=
# MODELKEYGUARD_AZURE_OPENAI_RECONCILE_URL=https://provider.example/reconcile/{request_id}
# MODELKEYGUARD_AZURE_OPENAI_RECONCILE_TOKEN=
# MODELKEYGUARD_GEMINI_RECONCILE_URL=https://provider.example/reconcile/{request_id}
# MODELKEYGUARD_GEMINI_RECONCILE_TOKEN=
# MODELKEYGUARD_OLLAMA_RECONCILE_URL=http://127.0.0.1:11434/reconcile/{request_id}
# MODELKEYGUARD_OLLAMA_RECONCILE_TOKEN=
# Optional live streaming gate (never enabled by default):
# MODELKEYGUARD_LIVE_OPENAI_URL=https://api.openai.com/v1/chat/completions
# MODELKEYGUARD_LIVE_OPENAI_KEY=
# MODELKEYGUARD_LIVE_OPENAI_MODEL=gpt-4o-mini
# MODELKEYGUARD_LIVE_AZURE_OPENAI_URL=https://RESOURCE.openai.azure.com/openai/deployments/DEPLOYMENT/chat/completions?api-version=2024-10-21
# MODELKEYGUARD_LIVE_AZURE_OPENAI_KEY=
# MODELKEYGUARD_LIVE_AZURE_OPENAI_MODEL=DEPLOYMENT
# MODELKEYGUARD_LIVE_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models/MODEL:streamGenerateContent
# MODELKEYGUARD_LIVE_GEMINI_KEY=
# MODELKEYGUARD_LIVE_GEMINI_MODEL=gemini-2.0-flash
# MODELKEYGUARD_LIVE_OLLAMA_URL=http://127.0.0.1:11434/api/chat
# MODELKEYGUARD_LIVE_OLLAMA_KEY=
# MODELKEYGUARD_LIVE_OLLAMA_MODEL=llama3.1
# MODELKEYGUARD_LIVE_REQUIRE_USAGE=0
MODELKEYGUARD_DRY_RUN=1
MODELKEYGUARD_HOST=0.0.0.0
MODELKEYGUARD_PORT=8789
MODELKEYGUARD_GRAPH_KEY_FILE=./secrets/modelkeyguard_graph_key
MODELKEYGUARD_POLICY_PATH=config/gateway_policy.json
MODELKEYGUARD_STORE=jsonl
MODELKEYGUARD_GRAPH_PATH=out/modelkeyguard_graph.jsonl
MODELKEYGUARD_AUDIT_PATH=out/audit.jsonl
# Provider keys: use *_FILE in real deployments, not raw .env values.
# Prefer registering provider keys after deploy through /admin/keys. Set this
# only when you intentionally want a runtime fallback provider secret file.
# MODELKEYGUARD_PROVIDER_KEY_OPENAI_FILE=./secrets/openai_provider_key
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=modelguard
KEYCLOAK_INTROSPECTION_CLIENT_ID=modelguard-gateway
KEYCLOAK_INTROSPECTION_CLIENT_SECRET_FILE=./secrets/keycloak_client_secret
